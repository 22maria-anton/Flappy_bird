#include "raylib.h"
#include <stdio.h>
#include <math.h>

#define SW          480      /* latime fereastra             */
#define SH          720      /* inaltime fereastra           */
#define GRAVITY     900.0f
#define FLAP       -380.0f   /* impuls la batai din aripi    */
#define PIPE_W       65      /* latimea tevii                */
#define GAP         175      /* spatiul dintre tevi          */
#define MAX_PIPES     6
#define GROUND      100      /* inaltimea solului            */
#define BIRD_R       22      /* raza pasarela                */
#define N_SKINS       8

typedef enum  { MENU, CHARSEL, PLAY, DEAD } State;
typedef struct { float x, y, vy; int skin; } Bird;
typedef struct { float x, gap_y; bool passed, active; } Pipe;

static const Color SKINS[N_SKINS] = {
    YELLOW, RED, SKYBLUE, ORANGE, PURPLE,PINK,LIME,BLACK
};
static const char *SKIN_NAMES[N_SKINS] = {
    "Galben","Rosu","Albastru","Portocaliu","Mov","Roz","Limegreen","Negru"
};

static int high_score = 0;
static bool new_record = false;

static void hs_load(void) {
    FILE *f = fopen("hs.dat", "r");
    if (f!=NULL) 
    { 
        fscanf(f, "%d", &high_score);
        fclose(f); 
    }
}

static void hs_save(int new_score) {
    new_record = (new_score > high_score);
    if (new_record) 
    {
        high_score = new_score;
        FILE *f = fopen("hs.dat", "w");
        if (f!=NULL) 
        { 
            fprintf(f, "%d", high_score); 
            fclose(f); 
        }
    }
}


static Color darker(Color c) {
    return (Color){
        (unsigned char)(c.r * 0.72f),
        (unsigned char)(c.g * 0.72f),
        (unsigned char)(c.b * 0.72f),
        c.a
    };
}

static void draw_bird(float x, float y, int skin) {
    Color c = SKINS[skin];
    /* Corp */
    DrawCircle((int)x, (int)y, BIRD_R, c);
    /* Aripa */
    DrawCircle((int)(x - 8), (int)(y + 6), 10, darker(c));
    /* Ochi */
    DrawCircle((int)(x + 10), (int)(y - 7), 6, WHITE);
    DrawCircle((int)(x + 12), (int)(y - 7), 3, BLACK);
    /* Cioc */
    DrawTriangle(
        (Vector2){x + BIRD_R,      y - 4},
        (Vector2){x + BIRD_R + 12, y + 1},
        (Vector2){x + BIRD_R,      y + 6},
        ORANGE
    );
}

static void draw_pipe(float px, float top_h, float bot_y) {
    Color body = (Color){83,  167,  72, 255};
    Color cap  = (Color){59,  130,  50, 255};
    /* Teava sus */
    DrawRectangle((int)px,      0,             PIPE_W,      (int)top_h, body);
    DrawRectangle((int)px - 6,  (int)(top_h - 28), PIPE_W+12, 28,        cap);
    /* Teava jos */
    DrawRectangle((int)px,      (int)bot_y,    PIPE_W,      SH,         body);
    DrawRectangle((int)px - 6,  (int)bot_y,    PIPE_W+12,   28,         cap);
}

static void draw_btn(Rectangle r, const char *txt, Color col, int fs) {
    DrawRectangleRec(r, col);
    DrawRectangleLinesEx(r, 3, darker(col));
    int tw = MeasureText(txt, fs);
    DrawText(txt,
             (int)(r.x + r.width  / 2 - tw / 2),
             (int)(r.y + r.height / 2 - fs / 2),
             fs, WHITE);
}

static bool btn_clicked(Rectangle r) {
    return IsMouseButtonPressed(MOUSE_LEFT_BUTTON)
        && CheckCollisionPointRec(GetMousePosition(), r);
}

static void game_reset(Bird *b, Pipe *pipes,
                        int *score, float *t, float *iv) {
    b->x  = SW * 0.25f;
    b->y  = SH * 0.45f;
    b->vy = 0.0f;
    *score = 0; *t = 0.0f; *iv = 1.8f;
    for (int i = 0; i < MAX_PIPES; i++)
        pipes[i].active = pipes[i].passed = false;
}

static void pipe_spawn(Pipe *pipes) {
    for (int i = 0; i < MAX_PIPES; i++) {
        if (!pipes[i].active) {
            pipes[i].x      = SW + 10.0f;
            pipes[i].gap_y  = 200.0f + (float)GetRandomValue(0, 270);
            pipes[i].passed = false;
            pipes[i].active = true;
            return;
        }
    }
}

int main(void) {
    InitWindow(SW, SH, "Flappy Bird  –  C + Raylib");
    SetTargetFPS(60);
    hs_load();

    State state  = MENU;
    Bird  bird   = { SW*0.25f, SH*0.45f, 0.0f, 0 };
    Pipe  pipes[MAX_PIPES];
    for (int i = 0; i < MAX_PIPES; i++)
        pipes[i].active = pipes[i].passed = false;

    int   score  = 0;
    float sp_t   = 0.0f, sp_iv = 1.8f;

    float cx[4] = {80.0f, 210.0f, 350.0f, 450.0f};
    float cy[4] = {80.0f, 115.0f,  72.0f, 130.0f};

    float gscr  = 0.0f;
    float mb_y  = SH * 0.32f, mb_d = 1.0f;

    /* MENU */
    Rectangle r_start = {SW/2.0f-100, SH*0.52f,       200, 54};
    Rectangle r_sel   = {SW/2.0f-100, SH*0.52f+65,    200, 54};
    Rectangle r_exit  = {SW/2.0f-100, SH*0.52f+130,   200, 54};
    /* DEAD */
    Rectangle r_retry = {SW/2.0f-95,  SH*0.62f,       190, 52};
    Rectangle r_menu2 = {SW/2.0f-95,  SH*0.62f+65,    190, 52};
    /* CHARSEL */

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();
        if (dt > 0.05f) dt = 0.05f;   /* protectie spike de timp */

        /* Viteza creste cu scorul */
        float speed = 220.0f + score * 10.0f;
        if (speed > 520.0f) speed = 520.0f;

        /* Scroll nori + sol */
        for (int i = 0; i < 4; i++) {
            cx[i] -= 28.0f * dt;
            if (cx[i] < -130.0f) cx[i] = SW + 130.0f;
        }
        gscr += speed * dt * 0.22f;
        if (gscr > 48.0f) gscr -= 48.0f;

        switch (state) {


        case MENU:
            mb_y += mb_d * 55.0f * dt;
            if (mb_y > SH * 0.37f) mb_d = -1.0f;
            if (mb_y < SH * 0.29f) mb_d =  1.0f;

            if (IsKeyPressed(KEY_SPACE) || btn_clicked(r_start)) {
                game_reset(&bird, pipes, &score, &sp_t, &sp_iv);
                state = PLAY;
            } else if (btn_clicked(r_sel)) {
                state = CHARSEL;
            } else if (btn_clicked(r_exit)) {
                CloseWindow();
                return 0;
            }
            break;

        case CHARSEL:
            if (IsKeyPressed(KEY_ESCAPE) || btn_clicked(r_back))
                state = MENU;

            for (int i = 0; i < N_SKINS; i++) {
                float rx = SW/2.0f - 155 + (i % 3) * 110;
                float ry = SH*0.22f + (i / 3) * 130;
                if (btn_clicked((Rectangle){rx, ry, 90, 90}))
                    bird.skin = i;
            }
            break;

        case PLAY:
            if (IsKeyPressed(KEY_SPACE) ||
                IsMouseButtonPressed(MOUSE_LEFT_BUTTON))
                bird.vy = FLAP;

            bird.vy += GRAVITY * dt;
            bird.y  += bird.vy  * dt;

            sp_t += dt;
            if (sp_t >= sp_iv) {
                pipe_spawn(pipes);
                sp_t  = 0.0f;
                sp_iv = 1.8f - score * 0.04f;
                if (sp_iv < 0.9f) sp_iv = 0.9f;
            }

            for (int i = 0; i < MAX_PIPES; i++) {
                if (!pipes[i].active) continue;
                pipes[i].x -= speed * dt;

                if (!pipes[i].passed && pipes[i].x + PIPE_W < bird.x) {
                    pipes[i].passed = true;
                    score++;
                }
                if (pipes[i].x + PIPE_W < 0)
                    pipes[i].active = false;

                float topH = pipes[i].gap_y - GAP / 2.0f;
                float botY = pipes[i].gap_y + GAP / 2.0f;
              
                Rectangle bR = { bird.x - BIRD_R + 7, bird.y - BIRD_R + 7,
                                 (BIRD_R - 7)*2.0f,   (BIRD_R - 7)*2.0f };
                Rectangle rT = { pipes[i].x, 0,    PIPE_W, topH };
                Rectangle rB = { pipes[i].x, botY, PIPE_W, (float)SH };

                if (CheckCollisionRecs(bR, rT) || CheckCollisionRecs(bR, rB)) {
                    hs_save(score);
                    state = DEAD;
                }
            }
            if (bird.y + BIRD_R >= SH - GROUND || bird.y - BIRD_R <= 0) {
                hs_save(score);
                state = DEAD;
            }
            break;
        case DEAD:
            bird.vy += GRAVITY * dt;
            bird.y  += bird.vy  * dt;
            if (bird.y > SH - GROUND - BIRD_R) {
                bird.y  = (float)(SH - GROUND - BIRD_R);
                bird.vy = 0.0f;
            }
            if (IsKeyPressed(KEY_SPACE) || btn_clicked(r_retry)) {
                game_reset(&bird, pipes, &score, &sp_t, &sp_iv);
                state = PLAY;
            } else if (btn_clicked(r_menu2)) {
                state = MENU;
            }
            break;
        }

   
        BeginDrawing();
        ClearBackground((Color){113, 197, 207, 255});

        /* Nori */
        for (int i = 0; i < 4; i++) {
            DrawEllipse((int)cx[i],       (int)cy[i],      52, 22, WHITE);
            DrawEllipse((int)cx[i] - 30,  (int)cy[i] + 10, 36, 18, WHITE);
            DrawEllipse((int)cx[i] + 34,  (int)cy[i] +  8, 38, 20, WHITE);
        }

        /* Tevi */
        for (int i = 0; i < MAX_PIPES; i++)
            if (pipes[i].active)
                draw_pipe(pipes[i].x,
                          pipes[i].gap_y - GAP / 2.0f,
                          pipes[i].gap_y + GAP / 2.0f);

        /* Sol */
        DrawRectangle(0, SH-GROUND, SW, GROUND, (Color){222,193,143,255});
        DrawRectangle(0, SH-GROUND, SW, 14,     (Color){111,196, 89,255});
        for (int x = -(int)gscr; x < SW; x += 48)
            DrawRectangle(x, SH-GROUND+14, 24, 8, (Color){200,175,130,255});

        /* Pasarea (ascunsa in meniu) */
        if (state != MENU) draw_bird(bird.x, bird.y, bird.skin);

        switch (state) {

        case MENU: {
            /* Titlu cu umbra */
            DrawText("FLAPPY BIRD",
                     SW/2 - MeasureText("FLAPPY BIRD",46)/2 + 2, 74, 46,
                     (Color){0,0,0,90});
            DrawText("FLAPPY BIRD",
                     SW/2 - MeasureText("FLAPPY BIRD",46)/2,     72, 46, WHITE);

            /* Pasarea animata */
            draw_bird(SW / 2.0f, mb_y, bird.skin);

            /* Record */
            if (hs > 0) {
                char buf[32]; sprintf(buf, "Record: %d", hs);
                DrawText(buf, SW/2 - MeasureText(buf,22)/2,
                         (int)(SH*0.44f), 22, YELLOW);
            }

            /* Butoane */
            draw_btn(r_start, "INCEPE JOC",     (Color){50,185,50,255},  20);
            draw_btn(r_sel,   "ALEGE PERSONAJ", (Color){50,130,230,255}, 17);
            draw_btn(r_exit,  "IESIRE",         (Color){210,50,50,255},  20);

            DrawText("SPATIU sau Click = Start",
                     SW/2 - MeasureText("SPATIU sau Click = Start",14)/2,
                     SH-GROUND-24, 14, (Color){255,255,255,180});
            break;
        }

        /* ---- UI SELECTARE PERSONAJ -------------------- */
        case CHARSEL: {
            DrawText("ALEGE PERSONAJUL",
                     SW/2 - MeasureText("ALEGE PERSONAJUL",28)/2,
                     55, 28, WHITE);

            for (int i = 0; i < N_SKINS; i++) {
                float rx = SW/2.0f - 155 + (i % 3)*110;
                float ry = SH*0.22f + (i / 3)*130;
                Rectangle r = {rx, ry, 90, 90};

                DrawRectangleRec(r, (i == bird.skin)
                    ? (Color){255,255,255,80} : (Color){0,0,0,50});
                if (i == bird.skin)
                    DrawRectangleLinesEx(r, 3, YELLOW);

                draw_bird(rx + 45, ry + 37, i);
                DrawText(SKIN_NAMES[i],
                         (int)(rx + 45 - MeasureText(SKIN_NAMES[i],13)/2),
                         (int)(ry + 68), 13, WHITE);
            }

            draw_btn(r_back, "INAPOI", (Color){200,50,50,255}, 20);
            DrawText("ESC = Inapoi",
                     SW/2 - MeasureText("ESC = Inapoi",14)/2,
                     (int)(SH*0.89f), 14, LIGHTGRAY);
            break;
        }

        /* ---- UI JOC ----------------------------------- */
        case PLAY: {
            /* Scor */
            char buf[16]; sprintf(buf, "%d", score);
            DrawText(buf, SW/2 - MeasureText(buf,50)/2 + 2, 42, 50,
                     (Color){0,0,0,80});
            DrawText(buf, SW/2 - MeasureText(buf,50)/2,     40, 50, WHITE);

            /* Viteza curenta */
            char sp_buf[32]; sprintf(sp_buf, "Viteza: %.0f", speed);
            DrawText(sp_buf, 10, 10, 16, (Color){255,255,255,210});

            DrawText("SPATIU / Click = Zbor",
                     SW/2 - MeasureText("SPATIU / Click = Zbor",14)/2,
                     SH-GROUND-22, 14, (Color){255,255,255,160});
            break;
        }

        /* ---- UI GAME OVER ----------------------------- */
        case DEAD: {
            DrawRectangle(0, 0, SW, SH, (Color){0,0,0,110});

            DrawText("GAME OVER",
                     SW/2 - MeasureText("GAME OVER",50)/2,
                     (int)(SH*0.22f), 50, RED);

            char s1[32], s2[32];
            sprintf(s1, "Scor: %d",   score);
            sprintf(s2, "Record: %d", hs);
            DrawText(s1, SW/2 - MeasureText(s1,28)/2, (int)(SH*0.40f), 28, WHITE);
            DrawText(s2, SW/2 - MeasureText(s2,26)/2, (int)(SH*0.47f), 26, YELLOW);

            if (new_record && score > 0)
                DrawText("NOU RECORD!",
                         SW/2 - MeasureText("NOU RECORD!",22)/2,
                         (int)(SH*0.54f), 22, (Color){255,215,0,255});

            draw_btn(r_retry, "INCEARCA DIN NOU", (Color){50,185,50,255},  15);
            draw_btn(r_menu2, "MENIU PRINCIPAL",  (Color){50,130,230,255}, 15);

            DrawText("SPATIU = Incearca din nou",
                     SW/2 - MeasureText("SPATIU = Incearca din nou",14)/2,
                     (int)(SH*0.87f), 14, LIGHTGRAY);
            break;
        }
        }

        EndDrawing();
    }

    CloseWindow();
    return 0;
}
